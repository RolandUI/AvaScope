<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>AvaScope.Bridge</PackageId>
    <Description>Opt-in local-only runtime inspection bridge for Avalonia applications.</Description>
    <PackageTags>avalonia;inspection;bridge;automation;mcp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the explicit minimum of the standalone 12.1.x contract.
         Desktop/headless hosts and validation use the latest supported patch. -->
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" Condition="'$(AvaScopeStandaloneProvider)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaScope.Core\AvaScope.Core.csproj" />
    <ProjectReference Include="..\AvaScope.Protocol\AvaScope.Protocol.csproj" />
  </ItemGroup>

</Project>
