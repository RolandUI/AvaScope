<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AvaScope.GettingStartedApp"
             x:Class="AvaScope.GettingStartedApp.App">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SampleWindowBrush" Color="#FFF7F8FA" />
          <SolidColorBrush x:Key="SampleAccentBrush" Color="#FF2563EB" />
          <SolidColorBrush x:Key="SampleAccentTextBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SampleWindowBrush" Color="#FF111827" />
          <SolidColorBrush x:Key="SampleAccentBrush" Color="#FF38BDF8" />
          <SolidColorBrush x:Key="SampleAccentTextBrush" Color="#FF06121F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="local:SampleStatus" x:DataType="local:SampleStatus">
      <Border AutomationProperties.AutomationId="RuntimeStatusCard"
              Background="{DynamicResource SampleAccentBrush}"
              CornerRadius="6"
              Padding="18">
        <StackPanel Spacing="8">
          <TextBlock Text="{CompiledBinding Title}"
                     Foreground="{DynamicResource SampleAccentTextBrush}"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <TextBlock Text="{CompiledBinding Detail}"
                     Foreground="{DynamicResource SampleAccentTextBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Application.DataTemplates>
</Application>
