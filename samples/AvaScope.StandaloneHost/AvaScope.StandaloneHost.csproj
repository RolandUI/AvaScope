<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>StandaloneInspectionHost</AssemblyName>
    <IsPackable>false</IsPackable>
    <AvaloniaVersion Condition="'$(AvaloniaVersion)' == ''">12.1.3</AvaloniaVersion>
    <DefineConstants Condition="'$(EnableUiInspection)' == 'true'">$(DefineConstants);ENABLE_UI_INSPECTION</DefineConstants>
    <DefineConstants Condition="'$(EnableTableFixture)' == 'true'">$(DefineConstants);TABLE_FIXTURE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" Condition="'$(EnableTableFixture)' == 'true'" />
    <Compile Include="../../docs/examples/OptionalProviderLoader.cs" Link="OptionalProviderLoader.cs" Condition="'$(EnableUiInspection)' == 'true'" />
  </ItemGroup>
</Project>
